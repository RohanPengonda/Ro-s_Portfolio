# Copy this file to .env and fill in your values.
# Gemini AI assistant — https://aistudio.google.com/apikey (free tier)
VITE_GEMINI_API_KEY=your_gemini_api_key

# EmailJS — https://www.emailjs.com (free tier)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Contact / social
VITE_EMAIL=rpengonda1@gmail.com
VITE_GITHUB_URL=https://github.com/RohanPengonda
VITE_LINKEDIN_URL=https://www.linkedin.com/in/rohanpengonda/

# Resume — absolute URL or path to a static asset (e.g. /resume.pdf)
VITE_RESUME_URL=/resume.pdf
